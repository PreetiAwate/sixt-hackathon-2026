# Edit your existing .env; do NOT copy this over a working key.
# These three active entries must contain your actual gateway configuration.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-6.1-sol

# Active conservative development settings. Restart GUI after changes.
PG_WORKERS=1
PG_MIN_GAP_SECONDS=0
PG_MAX_CONTEXT_CHARS=40000
PG_MAX_PAGES=8
PG_FIELDS_PER_CALL=18
PG_VERIFY_MAX_PER_DOC=60
PG_TIMEOUT=180
PG_VISION=auto
PG_JSON_MODE=0
PG_CACHE_DIR=.pg_cache

# Optional Microsoft Foundry Decision-1 verifier. Use the resource endpoint and
# the deployment name from Foundry; the adapter calls /providers/microsoft/v1/systemone.
# VERIFIER_API=foundry
# VERIFIER_BASE_URL=https://<your-foundry-resource-endpoint>
# VERIFIER_MODEL=<your-deployment-name>
# VERIFIER_API_KEY=
# Legacy H2O SystemOne remains supported with VERIFIER_API=systemone.
# Leave the verifier unset to reuse the extractor for verification.
# For a Microsoft Decision-1 gateway exposing /v1/systemone instead, use:
# VERIFIER_API=systemone
# VERIFIER_BASE_URL=https://<gateway-base-url>
# VERIFIER_MODEL=microsoft-decision-1
# VERIFIER_API_KEY=<gateway-api-key>
# CHALLENGER_BASE_URL=
# CHALLENGER_API_KEY=
# CHALLENGER_MODEL=
# ESCALATE_BASE_URL=
# ESCALATE_API_KEY=
# ESCALATE_MODEL=

# Set actual provider prices before reporting USD cost.
# Missing prices produce zero estimates, which mean UNKNOWN, not free.
# LLM_PRICE_IN=
# LLM_PRICE_OUT=
